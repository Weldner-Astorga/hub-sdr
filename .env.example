# ============================================================
# Hub SDR — Variáveis de Ambiente (template)
# Copie este arquivo para .env e preencha com seus valores
# NUNCA commite o arquivo .env com dados reais
# ============================================================

# ---------------------------
# Supabase
# ---------------------------
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sua_chave_anon_ou_service_aqui

# ---------------------------
# SMTP (envio de emails)
# ---------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_aqui
SMTP_FROM=sdr@suaempresa.com.br

# ---------------------------
# Telegram (alertas SDR)
# ---------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
TELEGRAM_SDR_CHAT_ID=-1001234567890

# ---------------------------
# n8n
# ---------------------------
N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com
N8N_API_KEY=sua_chave_api_n8n

# ---------------------------
# OpenAI (embeddings para RAG)
# ---------------------------
OPENAI_API_KEY=sk-...

# ---------------------------
# Configurações gerais
# ---------------------------
AMBIENTE=development
LOG_LEVEL=INFO
